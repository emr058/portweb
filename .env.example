# Başvuru sistemi (Vercel > Settings > Environment Variables). Anahtarlar kaynak koda yazılmaz.

# Supabase: Settings > API. service_role anahtarı yalnız sunucuda kullanılır, NEXT_PUBLIC_ ile başlamaz.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# IP özetinin tuzu (rastgele uzun bir metin). Boşsa service role anahtarı kullanılır.
IP_HASH_SECRET=

# Yönetici bildirimi (Resend). Üçü de doluysa e-posta gider; boşsa başvuru yine kaydedilir.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# WhatsApp numarası, ülke koduyla, artı ve boşluk olmadan (örn. 905551112233). Boşsa sitedeki iletişim telefonu kullanılır.
NEXT_PUBLIC_WHATSAPP_NUMBER=
